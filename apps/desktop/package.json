{
  "name": "@xhs/desktop",
  "version": "0.6.0",
  "description": "本地、只读的小红书单篇笔记评论分析工具",
  "author": "Local User",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "vite build --configLoader runner && esbuild ./src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs && esbuild ./src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs && esbuild ./src/maintenance-cli.ts --bundle --platform=node --format=cjs --outfile=dist/maintenance.cjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@xhs/shared": "0.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.local.xhs-comment-analyzer",
    "productName": "小红书评论分析工具",
    "artifactName": "XHS-Comment-Analyzer-Setup-${version}.${ext}",
    "asar": true,
    "electronDist": "../../node_modules/electron/dist",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../native-host/dist/xhs-comment-native-host.exe",
        "to": "native-host/xhs-comment-native-host.exe"
      },
      {
        "from": "../extension/dist",
        "to": "chrome-extension"
      },
      {
        "from": "../../scripts/diagnose-installed.ps1",
        "to": "diagnostics/diagnose-installed.ps1"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
